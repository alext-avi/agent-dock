FROM node:22-bookworm-slim

ENV NPM_CONFIG_PREFIX=/opt/opencode \
    PATH=/opt/opencode/bin:$PATH \
    HOME=/opencode-home \
    XDG_DATA_HOME=/opencode-home/.local/share \
    XDG_CONFIG_HOME=/opencode-home/.config \
    AGENT_ADAPTER=opencode

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10002 --create-home --home-dir /home/agent --shell /bin/sh agent \
    && mkdir -p /app /workspace /opencode-home/.local/share /opencode-home/.config /opt/opencode /agent-data \
    && chown -R agent:agent /app /workspace /opencode-home /opt/opencode /agent-data

WORKDIR /app
COPY --chown=agent:agent server.mjs protocol.mjs workload-auth.mjs entrypoint-opencode.sh ./
COPY --chown=agent:agent adapters ./adapters
COPY --chown=agent:agent mcp ./mcp
RUN chmod 0755 /app/entrypoint-opencode.sh

USER agent
WORKDIR /workspace
EXPOSE 7777
ENTRYPOINT ["/app/entrypoint-opencode.sh"]
