# Change this when the control plane is reachable by anything except your laptop.
WORKER_TOKEN=replace-with-a-long-random-value

# Host port for the browser UI and public control-plane API.
CONTROL_PLANE_PORT=3000

# "latest" proves runtime self-installation. Pin a version for repeatable deployments.
CODEX_VERSION=latest
CLAUDE_VERSION=latest

# Provider processes can act freely inside their worker container and mounted workspace.
ALLOW_UNSANDBOXED=1

# Minimum interval for supported provider quota refreshes. Every completed request updates local request totals.
USAGE_POLL_INTERVAL_MS=60000

# Optional display name for the initially registered worker.
DEFAULT_AGENT_NAME=Codex Worker 01
