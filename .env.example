# Change this when the control plane is reachable by anything except your laptop.
WORKER_TOKEN=replace-with-a-long-random-value

# Host port for the browser UI and public control-plane API.
CONTROL_PLANE_PORT=3000
# Compose publishes only on loopback by default. Set 0.0.0.0 only behind TLS
# after AUTH_MODE=oidc is configured. The control plane refuses to start in
# trusted-local mode when this is not a loopback address.
CONTROL_PLANE_BIND=127.0.0.1

# Control-plane operator authentication. trusted-local preserves the laptop-only
# POC experience and grants the local browser administrator access. Never expose
# trusted-local mode to another machine. Set this to oidc for any shared or remote
# deployment. The control plane also requires AUTH_PUBLIC_ORIGIN to be loopback
# in this mode. GitHub can be the upstream identity through an OIDC broker such
# as WorkOS AuthKit or Auth0; GitHub OAuth itself is not an OIDC issuer.
AUTH_MODE=trusted-local
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3000
AUTH_PROVIDER_NAME=GitHub

# OIDC settings. The callback URI registered with the provider must be
# ${AUTH_PUBLIC_ORIGIN}/auth/callback. AUTH_SESSION_SECRET must be at least 32
# bytes; generate a random value and never commit it. Prefer immutable OIDC sub
# values in role allowlists; email allowlists are supported only for bootstrap.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# Leave auto for standard OIDC providers. WorkOS Connect applications use
# client_secret_post, while public/native clients use none and omit the secret.
AUTH_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=auto
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_API_AUDIENCE=http://127.0.0.1:3000/api
AUTH_MCP_AUDIENCE=http://127.0.0.1:3000/mcp
# Optional laptop-only bearer token for Codex to reach /mcp in trusted-local
# mode. Use at least 32 random bytes and keep CONTROL_PLANE_BIND on 127.0.0.1.
# Leave empty in OIDC deployments; OIDC tokens are used there instead.
AUTH_LOCAL_MCP_TOKEN=
AUTH_OIDC_RESOURCE=
AUTH_OIDC_SCOPES=openid,profile,email
AUTH_DEFAULT_ROLE=viewer
AUTH_ADMIN_SUBJECTS=
AUTH_ADMIN_EMAILS=
AUTH_OPERATOR_SUBJECTS=
AUTH_OPERATOR_EMAILS=

# Durable scheduled jobs are polled by the control plane. Compose stores the
# SQLite database in its existing private control-data volume.
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MS=1000

# In OIDC mode, bearer tokens must use AUTH_MCP_AUDIENCE. Agent identities are
# fail-closed: they need an agent_id claim, fleet:read/tasks:execute scopes, and
# an explicit policy. Human access continues to follow the role table.
MCP_AGENT_POLICIES_JSON={}
MCP_MAX_DELEGATION_DEPTH=4
MCP_MAX_CONCURRENT_PER_CALLER=4
MCP_TASK_TIMEOUT_MS=3600000

# Additional comma-separated Host/Origin hostnames accepted by /mcp when a
# reverse proxy cannot preserve AUTH_PUBLIC_ORIGIN's hostname.
MCP_ALLOWED_HOSTNAMES=

# Local image tag used by both Compose bootstrap workers and dynamically provisioned agents.
AGENT_DOCK_IMAGE_TAG=local

# Optional host workspace paths. These are useful when Compose is launched from
# a Git worktree outside Docker Desktop's shared filesystem roots.
CODEX_WORKSPACE_PATH=./workspace
CLAUDE_WORKSPACE_PATH=./claude-workspace
OPENCODE_WORKSPACE_PATH=./opencode-workspace

# Optional host-folder roots that administrators may subdivide into named data
# sources from the Data tab. The browser never receives hostPath. Keep the
# control plane bound to loopback, approve the narrowest practical root, and set
# allowWrite only where an agent is permitted to modify host files. This is JSON
# on one line, for example:
# ATTACHMENT_ROOTS_JSON={"projects":{"label":"Projects","hostPath":"/Users/you/Projects","allowWrite":true},"reference":{"label":"Reference","hostPath":"/Users/you/Documents/reference","allowWrite":false}}
ATTACHMENT_ROOTS_JSON={}

# A locked-down, no-network helper container validates exact host subfolders as
# the target worker UID before each runtime replacement. This image must already
# be available to the Docker Engine; it is also the worker images' base image.
ATTACHMENT_VALIDATOR_IMAGE=node:22-bookworm-slim

# "latest" proves runtime self-installation. Pin a version for repeatable deployments.
CODEX_VERSION=latest
CLAUDE_VERSION=latest
OPENCODE_VERSION=latest

# OpenCode is multi-provider. The POC defaults its browser/device login to the
# officially supported GitHub Copilot subscription provider.
OPENCODE_AUTH_PROVIDER=github-copilot

# OpenCode can also discover and explicitly pin models served by Ollama on the
# Docker host. This internal URL is never returned by the browser-facing API.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CONNECTION_ID=ollama-local
OLLAMA_DISPLAY_NAME=Local Ollama

# Provider processes can act freely inside their worker container and mounted workspace.
ALLOW_UNSANDBOXED=1

# EXPERIMENTAL, off by default. Claude Code publishes no supported subscription
# usage API. Setting this to 1 lets the Claude worker read its own OAuth token
# and call Anthropic's undocumented /api/oauth/usage endpoint to report quota
# windows. The endpoint, its beta header, and its response schema can change
# without notice; the worker fails closed and keeps local request history either
# way. See worker/adapters/claude-usage.mjs.
CLAUDE_OAUTH_USAGE=0

# Floor between calls to that endpoint, independent of USAGE_POLL_INTERVAL_MS.
# The dashboard polls each agent's status every few seconds and each read asks
# for a usage refresh, so this is what actually bounds provider load. Thirty
# minutes: the endpoint is undocumented and does throttle, and this floor is per
# worker process, so agents signed in to one account multiply it. A five-hour
# quota window is still sampled ten times over. Lower it knowingly.
CLAUDE_OAUTH_USAGE_INTERVAL_MS=1800000

# Comma-separated executable allowlist for local stdio MCP servers. Empty denies
# all local MCP process definitions; remote HTTP MCP remains available.
# Note that allowlisting an interpreter — node, python, bash, npx — is equivalent
# to permitting arbitrary code execution, because the arguments are unconstrained.
MCP_ALLOWED_COMMANDS=

# Connector secrets do NOT go in this file. They live in .env.mcp-secrets, which
# the control plane reads separately, because this file is also used for Compose
# variable substitution and env_file cannot be scoped to a prefix.
#
# In .env.mcp-secrets, name each one MCP_SECRET_<NAME>. A definition referencing
# GITHUB_TOKEN reads MCP_SECRET_GITHUB_TOKEN; nothing outside that prefix is
# visible to the resolver, so a definition cannot name WORKER_TOKEN, a provider
# home, or OLLAMA_BASE_URL. Example:
#   MCP_SECRET_GITHUB_TOKEN=ghp_...
# These values reach every managed runtime and are readable by the agent there —
# see the security section of the README before deciding what to put in them.

# Minimum interval for supported provider quota refreshes. Every completed request updates local request totals.
USAGE_POLL_INTERVAL_MS=60000

# Optional display name for the initially registered worker.
DEFAULT_AGENT_NAME=Codex Worker 01
