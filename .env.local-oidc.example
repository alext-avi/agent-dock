# Durable, host-only OIDC profile for a single Agent Dock workstation.
# Copy this file to .env.local-oidc, replace every placeholder, and keep the
# resulting file local. Git ignores .env.local-oidc.

CONTROL_PLANE_BIND=127.0.0.1
CONTROL_PLANE_PORT=8787
WORKER_TOKEN=replace-with-a-long-random-value

CODEX_WORKSPACE_PATH=./workspace
CLAUDE_WORKSPACE_PATH=./claude-workspace
OPENCODE_WORKSPACE_PATH=./opencode-workspace

AUTH_MODE=oidc
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:8787
AUTH_PROVIDER_NAME=GitHub
AUTH_OIDC_ISSUER=https://your-staging-environment.authkit.app
AUTH_OIDC_CLIENT_ID=replace-with-the-agent-dock-web-client-id
AUTH_OIDC_CLIENT_SECRET=replace-with-the-agent-dock-web-client-secret
AUTH_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_SESSION_TTL_SECONDS=28800

# Register both URLs as WorkOS Connect Resource Indicators. Set /mcp as the
# default resource for MCP clients that omit the resource parameter.
AUTH_API_AUDIENCE=http://127.0.0.1:8787/api
AUTH_MCP_AUDIENCE=http://127.0.0.1:8787/mcp
AUTH_OIDC_RESOURCE=http://127.0.0.1:8787/api
AUTH_OIDC_SCOPES=openid,profile,email

AUTH_DEFAULT_ROLE=viewer
# Use a verified email only to bootstrap the first login. Replace it with the
# immutable WorkOS user subject in AUTH_ADMIN_SUBJECTS after the smoke test.
AUTH_ADMIN_EMAILS=replace-with-your-verified-github-email
AUTH_ADMIN_SUBJECTS=
AUTH_OPERATOR_EMAILS=
AUTH_OPERATOR_SUBJECTS=

# OIDC supplies MCP bearer tokens. Do not configure the trusted-local token.
AUTH_LOCAL_MCP_TOKEN=
